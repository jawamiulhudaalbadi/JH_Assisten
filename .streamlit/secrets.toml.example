# Isi nilainya melalui Streamlit Cloud Secrets, bukan dengan meng-commit rahasia.
FIREBASE_SERVICE_ACCOUNT = ""
# Separate Gemini keys; indexing and admin are never borrowed from chat.
GOOGLE_API_KEY = ""
GOOGLE_API_KEY_INDEX = ""
GOOGLE_API_KEY_ADMIN = ""
# Generate a Fernet key locally and keep it in Streamlit Secrets.
ENCRYPTION_KEY = ""
# Optional comma-separated model preference, e.g. gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_CHAT_MODELS = ""
# Legacy fallback; set or change the settings password from the Admin dashboard.
SETTINGS_PASSWORD = ""
# Format: pbkdf2_sha256$iterations$salt$hex_digest or scrypt$salt$hex_digest
ADMIN_CODE_HASH = ""
